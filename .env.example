# Local development (npm run dev)
DATABASE_URL="postgresql://as_english:as_english@localhost:5432/as_english?schema=public"
AUTH_SECRET="generate-a-long-random-secret"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# --- Ubuntu Docker deploy (auto-created by ./scripts/deploy.sh) ---
# Host 8010 is free on the current server (8001/8002/8004/8009/8012 are taken).
# Postgres stays on the Docker network only; it is not published to the host.
# APP_PORT=8010
# APP_URL=http://YOUR_SERVER_IP:8010
