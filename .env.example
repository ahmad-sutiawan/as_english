# Local development (npm run dev)
DATABASE_URL="postgresql://as_english:as_english@localhost:5432/as_english?schema=public"
AUTH_SECRET="generate-a-long-random-secret"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# --- Ubuntu Docker deploy (auto-created by ./scripts/deploy.sh) ---
# Host 8010 is HTTPS (mkcert). 8011 serves only rootCA.pem over HTTP so a phone
# can install the CA before it trusts https://IP:8010.
# Postgres stays on the Docker network only; it is not published to the host.
# APP_PORT=8010
# CA_PORT=8011
# APP_URL=https://YOUR_LAN_IP:8010
# POSTGRES_USER=as_english
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=as_english
# DATABASE_URL=postgresql://as_english:change-me@db:5432/as_english?schema=public
# AUTH_SECRET=generate-a-long-random-secret
# SEED_ON_START=true
