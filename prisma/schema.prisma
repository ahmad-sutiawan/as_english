generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  learner
  admin
}

model User {
  id           String     @id @default(cuid())
  name         String?
  email        String     @unique
  emailVerified DateTime?
  passwordHash String?
  image        String?
  role          Role       @default(learner)
  activePersona String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  accounts      Account[]
  sessions      Session[]
  progress      Progress[]
  attempts      Attempt[]
  quickStats    QuickStats[]
  speakStats    SpeakStats[]
  speakProgress SpeakProgress[]
  buildStats    BuildStats[]
  itemMemories  ItemMemory[]
  learnerStates LearnerState[]
}

model QuickStats {
  id           String    @id @default(cuid())
  userId       String
  persona      String    @default("it")
  xp           Int       @default(0)
  streak       Int       @default(0)
  bestStreak   Int       @default(0)
  lastPlayDate DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, persona])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Progress {
  id                String   @id @default(cuid())
  userId            String
  moduleId          String
  completedItemIds  String[] @default([])
  score             Int      @default(0)
  mastery           Json     @default("{}")
  lastSeenAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@index([userId])
}

model Attempt {
  id          String   @id @default(cuid())
  userId      String
  moduleId    String
  itemId      String
  typedAnswer String
  correct     Boolean
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, moduleId])
  @@index([itemId])
}

model BuildStats {
  id           String    @id @default(cuid())
  userId       String
  persona      String    @default("it")
  xp           Int       @default(0)
  streak       Int       @default(0)
  bestStreak   Int       @default(0)
  lastPlayDate DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, persona])
}

model SpeakStats {
  id           String    @id @default(cuid())
  userId       String
  persona      String    @default("it")
  xp           Int       @default(0)
  streak       Int       @default(0)
  bestStreak   Int       @default(0)
  sessionsDone Int       @default(0)
  lastPlayDate DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, persona])
}

model LearnerState {
  id               String   @id @default(cuid())
  userId           String
  persona          String
  placementPassed  Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, persona])
}

model ItemMemory {
  id            String    @id @default(cuid())
  userId        String
  persona       String
  source        String
  itemId        String
  moduleId      String    @default("")
  correctStreak Int       @default(0)
  lapseCount    Int       @default(0)
  intervalDays  Int       @default(0)
  nextReviewAt  DateTime
  lastResult    String
  graduated     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, persona, source, itemId])
  @@index([userId, persona, nextReviewAt])
}

model SpeakProgress {
  id             String    @id @default(cuid())
  userId         String
  itemId         String
  attempt1Score  Int       @default(0)
  attempt2Score  Int       @default(0)
  mastered       Boolean   @default(false)
  nextReviewAt   DateTime?
  lastTranscript String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId, nextReviewAt])
}
